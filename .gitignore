# 依赖
node_modules/

# 构建产物
dist/
target/

# 运行时状态（核心进程 / 实例快照 / 事件）
.orch/
**/.orch/

# 探针用的隔离 DSH_HOME（含会话缓存与本机路径，不作交付物）
probe/dsh-home/

# 探针运行时产物（ACL 备份含本机 SID / 绝对路径）
probe/runs/*/acl-recovery/

# mock 宿主运行时计数产物（prompt attempts，逐次运行生成）
.mock/
**/.mock/

# 临时脚本
probe/tmp-*.mjs
.tmp-*.mjs

# Tauri 生成的 ACL schemas（构建派生产物，裁决 U）
desktop/src-tauri/gen/

# 构建期生成的图标（Windows 资源所需；由 scripts/desktop/build.mjs 生成，不提交）
desktop/src-tauri/icons/
