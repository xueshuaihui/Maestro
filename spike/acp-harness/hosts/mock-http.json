{
  "name": "mock-http",
  "kind": "http-sse",
  "evidence": "mock",
  "represents": "WorkBuddy（ACP over HTTP+SSE）",
  "spawn": {
    "command": "node",
    "args": ["${SPIKE}/mock-acp-server/http-sse-server.mjs", "--dialect=load-only"],
    "cwd": "${WORKSPACE}"
  },
  "tokenEnv": "ACP_HTTP_TOKEN",
  "sessionDefaults": { "cwd": "${RUN_DIR}/sessions" }
}
